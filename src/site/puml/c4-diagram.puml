' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml ProjectLayoutComponentDiagram
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title Project Layout - Component Diagram

Person(developer, "Developer / Tool Integrator", "Uses the project layout API to inspect and process project structures.")

System_Ext(projectFiles, "Project File System", "Project roots, source and test directories, documentation directories, modules, and supported descriptors: pom.xml, build.gradle, package.json, pyproject.toml, and vcs-options.json.")
System_Ext(gradleBuild, "Gradle Build", "Provides the GradleProject model and child projects through a Tooling API connection.")

Container_Boundary(projectLibrary, "Project Layout Library") {
Boundary(projectCore, "org.machanism.machai.project") {
    Component(projectProcessor, "ProjectProcessor", "Abstract Java component", "Detects layouts; recursively scans each reported module, or delegates directly to the subclass when modules are null.")
    Component(projectLayoutManager, "ProjectLayoutManager", "Java utility", "Selects and configures the first matching layout in Maven, Gradle, JavaScript/TypeScript, Python, MS Access, then generic fallback order; fails for a missing project directory.")
}

Boundary(layoutComponents, "org.machanism.machai.project.layout") {
    Component(projectLayout, "ProjectLayout", "Abstract Java component", "Defines the layout contract: project metadata, modules, source, test, and documentation roots; provides path and filesystem utilities with exclusions.")
    Component(defaultLayout, "DefaultProjectLayout", "Java component", "Fallback layout whose module list is null and whose source, test, and documentation collections are empty; project processing therefore treats it as a leaf.")
    Component(mavenLayout, "MavenProjectLayout", "Java component", "Reads Maven modules and identifiers from the model, derives production roots from build metadata/defaults, reads configured test roots, and supplies src/site as the documentation root.")
    Component(gradleLayout, "GradleProjectLayout", "Java component", "Detects build.gradle, loads Gradle project children through the Tooling API, and exposes conventional src/main, src/test, and src/site roots.")
    Component(jsLayout, "JScriptProjectLayout", "Java / Jackson", "Reads package.json, expands array-form workspace globs, and exposes the package identifier; source, test, and documentation roots are not inferred.")
    Component(pythonLayout, "PythonProjectLayout", "Java / Tomlj", "Detects named public pyproject.toml projects, rejects classifiers containing Private, and provides empty source, test, and documentation collections without declaring modules.")
    Component(msAccessLayout, "MSAccessProjectLayout", "Java component", "Detects msaccess-vcs-addin exports by vcs-options.json in the project root or an immediate child; exposes the export directory as a source root, with no modules, tests, or documentation roots.")
    Component(pomReader, "PomReader", "Java / Maven Model API", "Parses and serializes Maven models, substitutes known properties, and carries forward licenses.")
}
}

Rel(developer, projectProcessor, "Starts project scanning with", "Java API")
Rel(developer, projectLayoutManager, "Requests layout detection from", "Java API")

Rel(projectProcessor, projectLayoutManager, "Detects a layout through")
Rel(projectProcessor, projectLayout, "Processes folders using the layout contract")
Rel(projectProcessor, projectProcessor, "Recursively scans each reported module")
Rel(projectLayoutManager, projectFiles, "Checks project descriptors in detection order")
Rel(projectLayoutManager, projectLayout, "Returns configured layout instance")
Rel(projectLayoutManager, mavenLayout, "Selects when pom.xml is present")
Rel(projectLayoutManager, gradleLayout, "Selects when build.gradle is present")
Rel(projectLayoutManager, jsLayout, "Selects when package.json is present")
Rel(projectLayoutManager, pythonLayout, "Selects when eligible pyproject.toml is present")
Rel(projectLayoutManager, msAccessLayout, "Selects when vcs-options.json identifies an Access export")
Rel(projectLayoutManager, defaultLayout, "Selects when no specialized layout matches")

Rel_U(defaultLayout, projectLayout, "Extends")
Rel_U(mavenLayout, projectLayout, "Extends")
Rel_U(gradleLayout, projectLayout, "Extends")
Rel_U(jsLayout, projectLayout, "Extends")
Rel_U(pythonLayout, projectLayout, "Extends")
Rel_U(msAccessLayout, projectLayout, "Extends")

Rel(projectLayout, projectFiles, "Lists directories and files, computes root-relative paths, and applies exclusions", "java.io.File / java.nio.file")
Rel(mavenLayout, projectFiles, "Detects pom.xml and resolves source and test paths")
Rel(mavenLayout, pomReader, "Uses for Maven metadata")
Rel(pomReader, projectFiles, "Reads pom.xml", "java.io.FileReader")
Rel(gradleLayout, projectFiles, "Detects build.gradle and conventional roots")
Rel(gradleLayout, gradleBuild, "Loads GradleProject model and child projects", "Gradle Tooling API")
Rel(jsLayout, projectFiles, "Detects and reads package.json and workspaces")
Rel(pythonLayout, projectFiles, "Detects and reads pyproject.toml")
Rel(msAccessLayout, projectFiles, "Detects vcs-options.json and identifies the export source directory")

SHOW_LEGEND()
@enduml
